generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PHARMACY_OWNER
  PHARMACY_MANAGER
  PHARMACIST
  DELIVERY_PARTNER
  ADMIN
}

enum StoreVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  OTP
}

enum OrderStatus {
  PLACED
  PRESCRIPTION_REVIEW
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PrescriptionStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  phone          String?      @unique
  passwordHash   String?      @map("password_hash")
  role           Role         @default(CUSTOMER)
  googleId       String?      @unique @map("google_id")
  emailVerified  Boolean      @default(false) @map("email_verified")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  stores         MedicalStore[] @relation("StoreOwner")
  sessions       Session[]
  otpCodes       OtpCode[]
  carts          Cart[]
  orders         CommerceOrder[]
  prescriptions  Prescription[]
  reviews        StoreReview[]
  wishlist       WishlistItem[]
  savedStores    SavedStore[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Session {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model OtpCode {
  id        String       @id @default(cuid())
  userId    String?      @map("user_id")
  target    String
  purpose   String
  codeHash  String       @map("code_hash")
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  provider  AuthProvider @default(OTP)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([target, purpose, expiresAt])
  @@map("otp_codes")
}

model MedicalStore {
  id                 String                  @id @default(cuid())
  ownerId            String                  @map("owner_id")
  name               String
  licenseNumber      String                  @unique @map("license_number")
  gstNumber          String?                 @unique @map("gst_number")
  addressLine1       String                  @map("address_line_1")
  addressLine2       String?                 @map("address_line_2")
  city               String
  state              String
  postalCode         String                  @map("postal_code")
  latitude           Decimal                 @db.Decimal(10, 7)
  longitude          Decimal                 @db.Decimal(10, 7)
  deliveryRadiusKm   Decimal                 @map("delivery_radius_km") @db.Decimal(5, 2)
  openingTime        String                  @map("opening_time")
  closingTime        String                  @map("closing_time")
  verificationStatus StoreVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?               @map("verified_at")
  verifiedById       String?                 @map("verified_by_id")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  owner              User                    @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  inventory          Inventory[]
  orders             CommerceOrder[]
  reviews            StoreReview[]
  savedBy            SavedStore[]

  @@index([ownerId])
  @@index([verificationStatus])
  @@index([city, state])
  @@map("medical_stores")
}

model Medicine {
  id                String      @id @default(cuid())
  brandName         String      @map("brand_name")
  genericName       String      @map("generic_name")
  manufacturer      String
  category          String
  dosageForm        String      @map("dosage_form")
  strength          String?
  requiresPrescription Boolean @default(false) @map("requires_prescription")
  description       String?
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  inventory         Inventory[]
  orderItems        CommerceOrderItem[]
  wishlistItems     WishlistItem[]

  @@index([brandName])
  @@index([genericName])
  @@index([category])
  @@map("medicines")
}

model Inventory {
  id           String       @id @default(cuid())
  storeId      String       @map("store_id")
  medicineId   String       @map("medicine_id")
  batchNumber  String       @map("batch_number")
  expiryDate   DateTime     @map("expiry_date")
  price        Decimal      @db.Decimal(12, 2)
  mrp          Decimal?     @db.Decimal(12, 2)
  stock        Int          @default(0)
  discountPct  Decimal      @default(0) @map("discount_pct") @db.Decimal(5, 2)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  store        MedicalStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  cartItems    CartItem[]
  images       InventoryImage[]

  @@unique([storeId, medicineId, batchNumber])
  @@index([storeId, stock])
  @@index([medicineId])
  @@index([expiryDate])
  @@map("inventory")
}

model InventoryImage {
  id          String    @id @default(cuid())
  inventoryId String    @map("inventory_id")
  imageUrl    String    @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, sortOrder])
  @@map("inventory_images")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique @map("user_id")
  couponCode String?   @map("coupon_code")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  @@map("carts")
}

model CartItem {
  id          String    @id @default(cuid())
  cartId      String    @map("cart_id")
  inventoryId String    @map("inventory_id")
  quantity    Int       @default(1)
  cart        Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  @@unique([cartId, inventoryId])
  @@map("cart_items")
}

model Prescription {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  fileUrl   String             @map("file_url")
  status    PrescriptionStatus @default(PENDING)
  note      String?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    CommerceOrder[]
  @@map("prescriptions")
}

model CommerceOrder {
  id             String        @id @default(cuid())
  orderNumber    String        @unique @map("order_number")
  userId         String        @map("user_id")
  storeId        String        @map("store_id")
  prescriptionId String?       @map("prescription_id")
  status         OrderStatus   @default(PLACED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  deliveryFee    Decimal       @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  deliveryAddress String       @map("delivery_address")
  etaMinutes     Int?          @map("eta_minutes")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  store          MedicalStore  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  items          CommerceOrderItem[]
  payment        Payment?
  @@index([userId, createdAt])
  @@index([storeId, status])
  @@map("commerce_orders")
}

model CommerceOrderItem {
  id          String        @id @default(cuid())
  orderId     String        @map("order_id")
  medicineId  String        @map("medicine_id")
  medicineName String       @map("medicine_name")
  quantity    Int
  unitPrice   Decimal       @map("unit_price") @db.Decimal(12, 2)
  order       CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine    Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  @@map("commerce_order_items")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique @map("order_id")
  provider        PaymentMethod
  providerOrderId String?       @unique @map("provider_order_id")
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  order           CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@map("payments")
}

model StoreReview {
  id        String       @id @default(cuid())
  storeId   String       @map("store_id")
  userId    String       @map("user_id")
  rating    Int
  comment   String?
  createdAt DateTime     @default(now()) @map("created_at")
  store     MedicalStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([storeId, userId])
  @@index([storeId, rating])
  @@map("store_reviews")
}

model WishlistItem {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  medicineId String   @map("medicine_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  @@unique([userId, medicineId])
  @@map("wishlist_items")
}

model SavedStore {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  storeId   String       @map("store_id")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     MedicalStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@unique([userId, storeId])
  @@map("saved_stores")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  body      String
  channel   String   @default("IN_APP")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
