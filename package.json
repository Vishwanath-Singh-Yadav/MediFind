{
  "name": "medifind",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --parallel --filter medifind-backend --filter medifind-frontend dev",
    "build": "pnpm --filter medifind-backend build && pnpm --filter medifind-frontend build",
    "backend": "pnpm --filter medifind-backend dev",
    "frontend": "pnpm --filter medifind-frontend dev",
    "prisma:generate": "pnpm --filter medifind-backend prisma:generate",
    "prisma:migrate": "pnpm --filter medifind-backend prisma:migrate"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "packageManager": "pnpm@9.15.4"
}
